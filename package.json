{
  "name": "@amazon-devices/whatsup",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "jest --colors ",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src test --ext .ts,.tsx",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "build:release": "node scripts/build-credits.mjs && WHATSUP_RELEASE=1 node scripts/build-web.mjs && react-native build-vega --build-type Release",
    "build:debug": "node scripts/build-credits.mjs && node scripts/build-web.mjs && react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "build:web": "node scripts/build-credits.mjs && node scripts/build-web.mjs",
    "test:web": "node --test tests/test-*.mjs",
    "serve": "node scripts/build-web.mjs && node scripts/dev-server.mjs assets",
    "build:vendor": "cd vendor && npm install && npm run build",
    "build:native": "cd native/keep-awake && npm install && npm run build",
    "check:drawn": "node scripts/check-drawn.mjs",
    "check:settings-edit": "node scripts/check-settings-edit.mjs",
    "check:picker-race": "node scripts/check-picker-race.mjs",
    "check:adjust-hold": "node scripts/check-adjust-hold.mjs",
    "check:safe-area": "node scripts/check-safe-area.mjs"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "@whatsup/keep-awake": "file:native/keep-awake",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "WhatsUp",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
